{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["gru1"],
  "functions": {
    "api/confirmar.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/lista", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
